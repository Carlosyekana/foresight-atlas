{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "foresight-atlas-ask",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  // Non-secret settings. GEMINI_API_KEY is a secret: `npx wrangler secret put GEMINI_API_KEY`.
  "vars": {
    "GEMINI_MODEL": "gemini-3.6-flash",
    // Internal reasoning before answering. "0" disables it; "" omits the field entirely.
    // This task needs none: the atlas is in the prompt and the output shape is fixed.
    "THINKING_BUDGET": "0",
    // Answers per UTC day across all visitors. The cost ceiling; raise once usage is known.
    "DAILY_CAP": "150",
    // Comma-separated. Localhost entries exist for `npm run dev` and `vite preview`.
    "ALLOWED_ORIGINS": "https://carlosyekana.github.io,http://localhost:5173,http://localhost:4173"
  },
  // Per-visitor burst limit, keyed by IP. Local to each Cloudflare location, approximate by design.
  "ratelimits": [
    { "name": "ASK_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  // Daily counter. Create once with `npx wrangler kv namespace create ASK_COUNTER` and paste the id here.
  "kv_namespaces": [
    { "binding": "ASK_COUNTER", "id": "c699eeb362fe4309930c33450b2419e4" }
  ]
}
